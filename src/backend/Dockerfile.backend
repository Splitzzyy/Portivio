# Backend Dockerfile for ASP.NET Core 10 (multi-stage)
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Copy solution and restore
COPY . ./
RUN dotnet restore Portivio.slnx

# Publish API project
RUN dotnet publish Portivio.API/Portivio.API.csproj -c Release -o /app/publish

# Runtime image
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
COPY --from=build /app/publish .
ENV ASPNETCORE_URLS="http://+:5274"
EXPOSE 5274
ENTRYPOINT ["dotnet", "Portivio.API.dll"]
