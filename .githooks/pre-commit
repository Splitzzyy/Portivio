#!/bin/sh
# Pre-commit secret scanner
# Blocks commits containing secrets, credentials, or private keys.
#
# Setup (once per clone):
#   git config core.hooksPath .githooks
#
# To bypass in emergencies (use sparingly):
#   git commit --no-verify

RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

FOUND=0

# Get staged file contents (excluding deleted files)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=d)

if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

# ── Pattern definitions ────────────────────────────────────────────────────────
# Format: "LABEL|REGEX"
PATTERNS="
PRIVATE_KEY|-----BEGIN (RSA |EC |DSA |OPENSSH )?PRIVATE KEY
AWS_ACCESS_KEY|AKIA[0-9A-Z]{16}
AWS_SECRET|aws_secret_access_key\s*[=:]\s*['\"][A-Za-z0-9/+]{40}['\"]
STRIPE_LIVE_SECRET|sk_live_[0-9a-zA-Z]{24,}
STRIPE_LIVE_PK|pk_live_[0-9a-zA-Z]{24,}
SENDGRID_KEY|SG\.[a-zA-Z0-9_-]{22,}\.[a-zA-Z0-9_-]{43,}
SLACK_TOKEN|xox[baprs]-[0-9A-Za-z-]{10,}
GITHUB_TOKEN|ghp_[0-9A-Za-z]{36}
GITHUB_TOKEN|github_pat_[0-9A-Za-z_]{82}
GOOGLE_CLIENT_SECRET|\"client_secret\":\s*\"[A-Za-z0-9_-]{24,}\"
GENERIC_SECRET|[Ss][Ee][Cc][Rr][Ee][Tt]\s*[=:]\s*['\"][A-Za-z0-9+/]{16,}['\"]
GENERIC_PASSWORD|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]\s*=\s*['\"][^'\"]{8,}['\"]
CONNECTION_STRING_PW|Password=[^;]{4,};
"

# ── Allowlisted patterns (safe values, skip these) ────────────────────────────
ALLOWLIST="
your_password
your_smtp_password
ReplaceWithA32CharOrLongerKey
PLACEHOLDER
example\.com
localhost
test@
dev@
"

# ── Scan each staged file ──────────────────────────────────────────────────────
echo "$STAGED_FILES" | while IFS= read -r FILE; do
  # Skip binary files
  if git diff --cached --binary -- "$FILE" | grep -q "^Binary"; then
    continue
  fi

  # Get staged content for this file
  CONTENT=$(git show ":$FILE" 2>/dev/null) || continue

  echo "$PATTERNS" | grep -v '^$' | while IFS='|' read -r LABEL PATTERN; do
    [ -z "$PATTERN" ] && continue

    # Find matching lines
    MATCHES=$(echo "$CONTENT" | grep -nE "$PATTERN" 2>/dev/null) || true
    [ -z "$MATCHES" ] && continue

    # Filter out allowlisted values
    FILTERED="$MATCHES"
    echo "$ALLOWLIST" | grep -v '^$' | while IFS= read -r SAFE; do
      [ -z "$SAFE" ] && continue
      FILTERED=$(echo "$FILTERED" | grep -v "$SAFE")
    done

    if [ -n "$FILTERED" ]; then
      printf "${RED}[SECRET DETECTED]${NC} ${YELLOW}%s${NC} in %s\n" "$LABEL" "$FILE" >&2
      echo "$FILTERED" | head -3 | while IFS= read -r LINE; do
        printf "  Line %s\n" "$LINE" >&2
      done
      # Signal failure via temp file (subshell can't set parent vars)
      echo "1" > /tmp/.pre-commit-secret-found
    fi
  done
done

# Check if any secrets were found
if [ -f /tmp/.pre-commit-secret-found ]; then
  rm -f /tmp/.pre-commit-secret-found
  printf "\n${RED}Commit blocked: secrets detected above.${NC}\n" >&2
  printf "Fix the issues, then stage again.\n" >&2
  printf "To bypass (emergency only): git commit --no-verify\n\n" >&2
  exit 1
fi

# ── Also block appsettings.Development.json if somehow staged ─────────────────
if git diff --cached --name-only | grep -q "appsettings\.Development\.json"; then
  printf "${RED}[BLOCKED]${NC} appsettings.Development.json is staged.\n" >&2
  printf "This file contains local secrets and must not be committed.\n" >&2
  printf "Run: git reset HEAD src/backend/Portivio.API/appsettings.Development.json\n\n" >&2
  exit 1
fi

exit 0
